+name: ci
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ["3.9", "3.10", "3.11", "3.12", "3.13"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+      - name: Unit tests (offline)
+        run: python -m unittest discover -s tests -v
+      - name: CLI smoke test (offline, cached fixtures not required)
+        run: |
+          python -m cvere --version
+          python -m cvere --list-sources
+          python -m cvere --logo
+      - name: Parse the example scans
+        run: |
+          python - <<'PY'
+          from cvere import nmap
+          for f in ("examples/scan.xml", "examples/scan.txt"):
+              services = nmap.parse(open(f, encoding="utf-8").read())
+              assert services, f
+              print(f, "->", len(services), "services")
+          PY
+
+  package:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - run: pip install build && python -m build
+      - name: Install the wheel and run it
+        run: |
+          pip install dist/*.whl
+          cvere --version
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dist
+          path: dist/*
